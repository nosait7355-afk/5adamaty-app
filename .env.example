##############################################################################
# خدماتي الفيوم — نموذج متغيرات البيئة
#
# انسخ هذا الملف إلى `.env.local` واملأ القيم الحقيقية.
# `.env.local` مستبعد من Git — لا تضع فيه أي قيمة حقيقية هنا.
#
# قاعدة أمنية: كل ما يبدأ بـ NEXT_PUBLIC_ يصل إلى المتصفح.
# ممنوع منعًا باتًا وضع أي سرّ خلف هذه البادئة.
##############################################################################

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- MongoDB Atlas (تصبح إلزامية في Phase 2) ----
MONGODB_URI=
MONGODB_DB_NAME=khadamaty_elfayoum

# ---- JWT (تصبح إلزامية في Phase 3) ----
# ولّد كل مفتاح بـ 32 بايت عشوائي على الأقل:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Cloudinary (إلزامية منذ Phase 4) ----
# من لوحة تحكم Cloudinary → Settings → API Keys
#
# ⚠️ API_SECRET سرّ خادم مطلق: لا يغادر السيرفر أبدًا ولا يُشتق منه أي
#    متغيّر NEXT_PUBLIC_. المتصفح يتلقى **توقيعًا** لعملية رفع واحدة فقط.
#
# للتحقق من صحتها فعليًا:  npm run check:cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# مفتاح الرموز الموقّتة (hex) — Settings → Security → Token-based authentication
# بدونه تبقى روابط المستندات موقّعة وغير قابلة للتخمين، لكن **بلا انتهاء زمني**.
# اضبطه لتفعيل صلاحية 5 دقائق كما نصّت المعمارية.
CLOUDINARY_AUTH_TOKEN_KEY=

# اسم السحابة فقط متاح للمتصفح — وهو ليس سرًّا
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- تسجيل الدخول بجوجل ----
# 1. Google Cloud Console → APIs & Services → Credentials
#    → Create Credentials → OAuth client ID → Web application
# 2. Authorized JavaScript origins: أضِف رابط الموقع (مثال:
#    https://5adamaty-app.vercel.app) ورابط التطوير المحلي إن لزم.
# 3. انسخ الـClient ID هنا فقط — لا يوجد Client Secret مطلوب لهذا المسار
#    (السيرفر يتحقق من idToken مباشرة عبر مفاتيح جوجل العامة).
# القيمة نفسها في المتغيّرين معًا — ليست سرًّا، فهي تُرسل للمتصفح أصلًا.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Resend — بريد إعادة تعيين كلمة المرور فقط (اختياري، Phase 10) ----
# اختياريان تمامًا: بدونهما يعمل النظام في وضع «تسجيل فقط» (اللينك يظهر في
# اللوج للمطوّر، ولا يُرسل شيء في الإنتاج). أضِف المفتاحين هنا لتفعيل
# الإرسال الفعلي فورًا — بلا أي تعديل كود.
#   1. أنشئ حساب Resend ووثّق نطاقًا (Domains → Add Domain)
#   2. API Keys → Create API Key
RESEND_API_KEY=
RESEND_FROM_EMAIL=
